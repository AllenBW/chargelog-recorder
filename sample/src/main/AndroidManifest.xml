<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No permissions of its own: the five the recorder needs merge in from its manifest, and
         nothing here talks to the network. (Five since REQUEST_IGNORE_BATTERY_OPTIMIZATIONS was
         removed from the library — a host that wants the exemption prompt declares it itself.) -->
    <application
        android:name=".SampleApp"
        android:label="@string/app_name"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".SampleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Scoped to cache/share/ only — see SampleActivity.share() for why the share copy is
             staged there rather than served straight out of the recorder's log directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
